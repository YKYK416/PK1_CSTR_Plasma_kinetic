! ============================================================
! 最小 N2/H2 示例机理（zdp_gui 向导模板）
! 5 物种 2 反应：N2/H2 电子碰撞电离（速率取自 bolsigdb.dat）
! 需要截面库中包含 "N2 -> N2^+" 与 "H2 -> H2^+" 过程
! ============================================================

ELEMENTS
E N H
END

SPECIES
E N2 H2 N2^+ H2^+
END

BOLSIG
N2
H2
END

REACTIONS
E + N2 => E + E + N2^+   ! BOLSIG N2 -> N2^+
E + H2 => E + E + H2^+   ! BOLSIG H2 -> H2^+
END
